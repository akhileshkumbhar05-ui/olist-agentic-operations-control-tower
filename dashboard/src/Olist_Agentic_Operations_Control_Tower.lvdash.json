{
  "datasets": [
    {
      "name": "orders",
      "displayName": "orders",
      "queryLines": [
        "SELECT date_trunc('MONTH',purchase_date) AS purchase_month,customer_state,order_status,\n",
        "COUNT(*) AS total_orders,\n",
        "SUM(CASE WHEN is_delivered THEN 1 ELSE 0 END) AS delivered_orders,\n",
        "SUM(CASE WHEN is_delivered THEN COALESCE(item_gmv,0) ELSE 0 END) AS delivered_item_gmv,\n",
        "SUM(CASE WHEN delivery_eligible THEN 1 ELSE 0 END) AS eligible_deliveries,\n",
        "SUM(CASE WHEN delivery_eligible AND is_late THEN 1 ELSE 0 END) AS late_orders\n",
        "FROM workspace.olist_semantic.v_published_orders\n",
        "GROUP BY 1,2,3\n"
      ]
    },
    {
      "name": "metric_baseline",
      "displayName": "metric_baseline",
      "queryLines": [
        "SELECT MEASURE(total_orders) AS total_orders,\nMEASURE(delivered_orders) AS delivered_orders,\nMEASURE(gmv) AS delivered_item_gmv,\nMEASURE(late_rate) AS late_rate,\nMEASURE(on_time_rate) AS on_time_rate,\nMEASURE(negative_review_rate) AS negative_review_rate\nFROM workspace.olist_semantic.mv_order_operations\n"
      ]
    },
    {
      "name": "rule_results",
      "displayName": "rule_results",
      "queryLines": [
        "SELECT r.rule_id,r.dataset,r.status,r.action,r.records_failed,g.plain_english_description,g.why_this_action,g.downstream_effect FROM workspace.olist_agentic_quality.dq_rule_results r JOIN workspace.olist_agentic_quality.published_run p ON p.run_id=r.run_id LEFT JOIN workspace.olist_governance.dq_rules g ON r.rule_id=g.rule_id\n"
      ]
    },
    {
      "name": "quarantine",
      "displayName": "quarantine",
      "queryLines": [
        "SELECT q.dataset,q.rule_id,q.source_record_id,q.failure_reason FROM workspace.olist_agentic_quality.quarantine q JOIN workspace.olist_agentic_quality.published_run p ON p.run_id=q.run_id\n"
      ]
    },
    {
      "name": "dictionary",
      "displayName": "dictionary",
      "queryLines": [
        "SELECT metric_name,business_definition,formula_description,unit,known_caveat FROM workspace.olist_governance.metric_dictionary\n"
      ]
    },
    {
      "name": "state_delivery_rates",
      "displayName": "State late-delivery rates (eligible denominator)",
      "queryLines": [
        "SELECT customer_state,\nSUM(CASE WHEN delivery_eligible AND is_late THEN 1 ELSE 0 END) AS late_deliveries,\nSUM(CASE WHEN delivery_eligible THEN 1 ELSE 0 END) AS eligible_deliveries,\nROUND(100.0 * SUM(CASE WHEN delivery_eligible AND is_late THEN 1 ELSE 0 END)\n  / NULLIF(SUM(CASE WHEN delivery_eligible THEN 1 ELSE 0 END), 0), 4) AS late_rate_pct\nFROM workspace.olist_semantic.v_published_orders\nGROUP BY customer_state\n"
      ]
    },
    {
      "name": "quality_snapshot",
      "displayName": "Published-run quality summary",
      "queryLines": [
        "SELECT s.quality_score,s.failed_rules,s.quarantined_records,s.readiness\nFROM workspace.olist_agentic_quality.dq_run_summary s\nJOIN workspace.olist_agentic_quality.published_run p ON s.run_id=p.run_id\n"
      ]
    }
  ],
